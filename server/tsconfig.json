{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.node.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "outDir": "../dist/server",
    "rootDir": "./",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true
  },
  "include": ["**/*.ts"],
  "exclude": ["../node_modules", "../dist"]
}
